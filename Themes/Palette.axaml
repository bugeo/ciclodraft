<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette ripresa da SpeedVision (tema scuro, accento verde): stessi colori nelle due applicazioni -->
    <Color x:Key="LineAColor">#FF4CC2FF</Color>
    <Color x:Key="LineBColor">#FFFFB547</Color>
    <Color x:Key="OkColor">#FF5EE09A</Color>
    <Color x:Key="ErrorColor">#FFFF6B6B</Color>

    <SolidColorBrush x:Key="LineABrush" Color="{StaticResource LineAColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource LineBColor}" />

    <SolidColorBrush x:Key="WindowBackground" Color="#FF1B1F26" />
    <SolidColorBrush x:Key="RailBackground" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PanelBackground" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBackground" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="HoverBackground" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="SelectedBackground" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF3F5F8" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFAAB2BF" />
    <SolidColorBrush x:Key="TextTertiary" Color="#FF7D8593" />

    <!-- Colore primario: verde (pulsanti principali, riquadro del passo da fare, selezioni) -->
    <Color x:Key="AccentColor">#FF2FCB79</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <Color x:Key="SystemAccentColor">#FF1FA85F</Color>
    <Color x:Key="SystemAccentColorLight1">#FF2FCB79</Color>
    <Color x:Key="SystemAccentColorLight2">#FF4DDB8F</Color>
    <Color x:Key="SystemAccentColorLight3">#FF7BE8AE</Color>
    <Color x:Key="SystemAccentColorDark1">#FF188A4E</Color>
    <Color x:Key="SystemAccentColorDark2">#FF116B3C</Color>
    <Color x:Key="SystemAccentColorDark3">#FF0B4D2B</Color>

    <!-- Icone (Material Design Icons, licenza Apache 2.0) -->
    <StreamGeometry x:Key="IconPencil">M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6.02 20.71,5.63L18.37,3.29C17.98,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
    <StreamGeometry x:Key="IconRedo">M12,6V9L16,5L12,1V4A8,8 0 0,0 4,12C4,13.57 4.46,15.03 5.24,16.26L6.7,14.8C6.25,13.97 6,13 6,12A6,6 0 0,1 12,6M18.76,7.74L17.3,9.2C17.74,10.04 18,11 18,12A6,6 0 0,1 12,18V15L8,19L12,23V20A8,8 0 0,0 20,12C20,10.43 19.54,8.97 18.76,7.74Z</StreamGeometry>
    <StreamGeometry x:Key="IconFloppy">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</StreamGeometry>
    <StreamGeometry x:Key="IconArrowLeft">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</StreamGeometry>
    <StreamGeometry x:Key="IconArrowRight">M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z</StreamGeometry>
    <!-- variatore di sezione: una corsia che si allarga -->
    <StreamGeometry x:Key="IconVariator">M2,7H9L15,4H22V6H15.5L9.5,9H2V7M2,15H9.5L15.5,18H22V20H15L9,17H2V15M5,11H19V13H5V11Z</StreamGeometry>
    <StreamGeometry x:Key="IconEye">M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z</StreamGeometry>
    <StreamGeometry x:Key="IconFolderOpen">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z</StreamGeometry>
</ResourceDictionary>
