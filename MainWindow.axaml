<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CicloDraft.Controls"
        xmlns:io="using:CicloDraft.IO"
        xmlns:local="using:CicloDraft"
        x:Class="CicloDraft.MainWindow"
        Title="CicloDraft"
        Width="1440" Height="880" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen">
  <DockPanel>

    <!-- Barra dei menu -->
    <Border DockPanel.Dock="Top" Classes="toolbar" Padding="10,2">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,10,0">
          <Border Width="22" Height="22" CornerRadius="11" Background="#D6603F">
            <TextBlock Text="C" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="CicloDraft" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        </StackPanel>
        <Menu x:Name="MainMenu" VerticalAlignment="Center">
          <MenuItem Header="_File">
            <MenuItem x:Name="OpenProjMenu" Header="Apri progetto…" InputGesture="Ctrl+O" />
            <MenuItem x:Name="OpenGpkgMenu" Header="Apri GeoPackage…" />
            <MenuItem x:Name="ClipMenu" Header="Ritaglia dati…" />
            <Separator />
            <MenuItem x:Name="SaveProjMenu" Header="Salva" InputGesture="Ctrl+S" />
            <MenuItem x:Name="SaveAsProjMenu" Header="Salva con nome…" />
          </MenuItem>
          <MenuItem Header="_Modifica">
            <MenuItem x:Name="UndoMenu" Header="Annulla" InputGesture="Ctrl+Z" />
            <MenuItem x:Name="RedoMenu" Header="Ripeti" InputGesture="Ctrl+Y" />
          </MenuItem>
          <MenuItem Header="_Esporta">
            <MenuItem x:Name="ExportDxfMenu" Header="DXF…" />
            <MenuItem x:Name="Export3DMenu" Header="3D…" />
            <MenuItem x:Name="ExportCsvMenu" Header="CSV…" />
            <MenuItem x:Name="ExportPdfMenu" Header="PDF…" />
          </MenuItem>
          <MenuItem Header="_Visualizza">
            <MenuItem x:Name="MapLabelsMenu" Header="Etichette con i nomi degli elementi" ToggleType="CheckBox" IsChecked="True" />
            <MenuItem x:Name="PhotoIconsMenu" Header="Icone dei fotoinserimenti" ToggleType="CheckBox" IsChecked="True" />
            <MenuItem x:Name="NotesMenu" Header="Disegni e note" ToggleType="CheckBox" IsChecked="True" />
            <Separator />
            <MenuItem x:Name="DxfContextOnMenu" Header="DXF con contesto" ToggleType="Radio" GroupName="dxfctx" IsChecked="True" />
            <MenuItem x:Name="DxfContextOffMenu" Header="DXF senza contesto" ToggleType="Radio" GroupName="dxfctx" />
            <Separator />
            <MenuItem x:Name="DxfLabelsOnMenu" Header="DXF con etichette" ToggleType="Radio" GroupName="dxflab" IsChecked="True" />
            <MenuItem x:Name="DxfLabelsOffMenu" Header="DXF senza etichette" ToggleType="Radio" GroupName="dxflab" />
          </MenuItem>
        </Menu>
      </DockPanel>
    </Border>

    <!-- Barra di stato -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar" Padding="12,6">
      <DockPanel>
        <TextBlock x:Name="CoordText" DockPanel.Dock="Right" FontFeatures="+tnum" Foreground="{StaticResource TextSecondary}" FontSize="12" />
        <TextBlock x:Name="StatusText" Text="Apri un progetto o un GeoPackage per iniziare." TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
      </DockPanel>
    </Border>

    <!-- ═══════════ Pannello sinistro: la guida, un riquadro per passo ═══════════ -->
    <Border DockPanel.Dock="Left" Width="350" Classes="panel" BorderThickness="0,0,1,0">
      <ScrollViewer x:Name="LeftScroll">
        <StackPanel Margin="16,14,16,16">

          <!-- 2. Livelli: da confermare prima di disegnare -->
          <Border x:Name="LayersCard" Classes="card" IsVisible="False">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button x:Name="EditLayersBtn" DockPanel.Dock="Right" Classes="link" Content="Modifica" IsVisible="False" VerticalAlignment="Center" />
                <TextBlock Classes="sectionTitle" Text="Livelli" />
              </DockPanel>
              <TextBlock x:Name="FileText" Classes="note" Foreground="{StaticResource TextPrimary}" />
              <TextBlock x:Name="CrsText" Classes="note" />
              <TextBlock x:Name="LayersSummary" Classes="note" IsVisible="False" />
              <StackPanel x:Name="LayersBody" Spacing="8">
                <TextBlock Classes="note" Text="Per ogni livello scegli il ruolo e se vederlo sulla mappa. Il programma propone i ruoli dai nomi: controllali e conferma." />
                <ItemsControl x:Name="LayersList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="io:GpkgLayer">
                      <Border Classes="inset" Margin="0,0,0,6">
                        <StackPanel Spacing="6">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding Info}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextTertiary}" />
                          </StackPanel>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <ComboBox HorizontalAlignment="Stretch" FontSize="12" SelectedIndex="{Binding Role, Mode=TwoWay}">
                              <ComboBoxItem>Nascosto</ComboBoxItem>
                              <ComboBoxItem>Muri abitazioni</ComboBoxItem>
                              <ComboBoxItem>Marciapiedi</ComboBoxItem>
                              <ComboBoxItem>Sfondo</ComboBoxItem>
                              <ComboBoxItem>Edifici 3D</ComboBoxItem>
                            </ComboBox>
                            <CheckBox Grid.Column="1" Content="Visibile" FontSize="12" IsChecked="{Binding Visible, Mode=TwoWay}" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ConfirmLayersBtn" Classes="wide primary" Content="Conferma i livelli" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- schede: un riquadro alla volta -->
          <Border x:Name="LeftTabs" Classes="tabs" IsVisible="False">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="3">
              <Button x:Name="LTabGroups" Classes="tab" Padding="4,8">
                <StackPanel Spacing="1">
                  <TextBlock Text="Gruppi" FontSize="13" HorizontalAlignment="Center" />
                  <TextBlock x:Name="LCntGroups" Text="(0)" FontSize="12" HorizontalAlignment="Center" Opacity="0.75" />
                </StackPanel>
              </Button>
              <Button x:Name="LTabPhotos" Grid.Column="1" Classes="tab" Padding="4,8">
                <StackPanel Spacing="1">
                  <TextBlock Text="Foto ins." FontSize="13" HorizontalAlignment="Center" />
                  <TextBlock x:Name="LCntPhotos" Text="(0)" FontSize="12" HorizontalAlignment="Center" Opacity="0.75" />
                </StackPanel>
              </Button>
              <Button x:Name="LTabSections" Grid.Column="2" Classes="tab" Padding="4,8">
                <StackPanel Spacing="1">
                  <TextBlock Text="Sezioni" FontSize="13" HorizontalAlignment="Center" />
                  <TextBlock x:Name="LCntSections" Text="(0)" FontSize="12" HorizontalAlignment="Center" Opacity="0.75" />
                </StackPanel>
              </Button>
              <Button x:Name="LTabElements" Grid.Column="3" Classes="tab on" Padding="4,8">
                <StackPanel Spacing="1">
                  <TextBlock Text="Elementi" FontSize="13" HorizontalAlignment="Center" />
                  <TextBlock x:Name="LCntElements" Text="(0)" FontSize="12" HorizontalAlignment="Center" Opacity="0.75" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <Border x:Name="GroupsCard" Classes="card" IsVisible="False">
            <StackPanel Spacing="6">
              <DockPanel>
                <Button x:Name="NewGroupBtn" DockPanel.Dock="Right" Padding="10,4" VerticalAlignment="Center" ToolTip.Tip="Nuovo gruppo (l'elemento selezionato ci entra)">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="+" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="Nuovo" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="sectionTitle" Text="Gruppi" VerticalAlignment="Center" IsVisible="False" />
                <TextBox x:Name="GroupSearch" Watermark="Cerca…" FontSize="12" Padding="8,4" MinHeight="28" VerticalAlignment="Center" Margin="0,0,8,0" />
              </DockPanel>
              <StackPanel x:Name="GroupList" Spacing="2" />
            </StackPanel>
          </Border>

          <Border x:Name="ElementsCard" Classes="card" IsVisible="False">
            <StackPanel Spacing="6">
              <DockPanel>
                <Button x:Name="NewElemListBtn" DockPanel.Dock="Right" Padding="10,4" VerticalAlignment="Center" ToolTip.Tip="Aggiungi un nuovo elemento">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="+" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="Nuovo" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="sectionTitle" Text="Elementi" VerticalAlignment="Center" IsVisible="False" />
                <TextBox x:Name="ElemSearch" Watermark="Cerca…" FontSize="12" Padding="8,4" MinHeight="28" VerticalAlignment="Center" Margin="0,0,8,0" />
              </DockPanel>
              <TextBlock x:Name="NoElemText" Classes="note" Text="Nessun elemento. Premi «+ Nuovo» (o «Aggiungi elemento» in alto sulla mappa) per disegnare il primo." />
              <ListBox x:Name="ElementsList" MaxHeight="320">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ElementRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Area}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFeatures="+tnum" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border x:Name="PhotosCard" Classes="card" IsVisible="False">
            <StackPanel Spacing="6">
              <DockPanel>
                <Button x:Name="NewPhotoBtn" DockPanel.Dock="Right" Padding="10,4" VerticalAlignment="Center" ToolTip.Tip="Nuovo fotoinserimento: scegli la foto">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="+" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="Nuovo" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="sectionTitle" Text="Fotoinserimenti" VerticalAlignment="Center" IsVisible="False" />
                <TextBox x:Name="PhotoSearch" Watermark="Cerca…" FontSize="12" Padding="8,4" MinHeight="28" VerticalAlignment="Center" Margin="0,0,8,0" />
              </DockPanel>
              <TextBlock x:Name="NoPhotoText" Classes="note" Text="Nessun fotoinserimento. Premi «Nuovo» e scegli una foto della via." />
              <StackPanel x:Name="PhotoList" Spacing="2" />
            </StackPanel>
          </Border>

          <Border x:Name="SectionsCard" Classes="card" IsVisible="False">
            <StackPanel Spacing="6">
              <DockPanel>
                <Button x:Name="NewSectionBtn" DockPanel.Dock="Right" Padding="10,4" VerticalAlignment="Center" ToolTip.Tip="Nuova sezione: clic sul punto A e sul punto B sulla mappa">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="+" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="Nuova" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="sectionTitle" Text="Sezioni" VerticalAlignment="Center" IsVisible="False" />
                <TextBox x:Name="SectionSearch" Watermark="Cerca…" FontSize="12" Padding="8,4" MinHeight="28" VerticalAlignment="Center" Margin="0,0,8,0" />
              </DockPanel>
              <TextBlock x:Name="NoSectionText" Classes="note" Text="Nessuna sezione. Premi «+ Nuova» e clicca due punti A e B sulla mappa, da un lato all'altro della strada." />
              <StackPanel x:Name="SectionList" Spacing="2" />
            </StackPanel>
          </Border>

          <Border x:Name="TotalsCard" Classes="card" IsVisible="False">
            <StackPanel Spacing="6">
              <TextBlock Classes="sectionTitle" Text="Totali per tipo" />
              <ItemsControl x:Name="TotalsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:TotalRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                      <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" FontFeatures="+tnum" Foreground="{StaticResource TextPrimary}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border x:Name="ViewHelp" Padding="2,4">
            <StackPanel Spacing="4">
              <TextBlock Classes="step" Text="COMANDI VISTA" />
              <TextBlock Classes="note" Text="Rotella: zoom · trascina con il tasto destro o centrale: sposta · clic su un elemento: seleziona · Esc: annulla" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>


    <Panel>
      <c:MapCanvas x:Name="Map" />
      <!-- testo di una nota mentre lo si scrive -->
      <Canvas x:Name="NoteCanvas">
        <TextBox x:Name="NoteTextBox" IsVisible="False" MinWidth="160" AcceptsReturn="True" FontWeight="SemiBold" Padding="4,2" />
      </Canvas>
      <!-- in alto a sinistra: adatta la vista a tutto il disegno -->
      <!-- in alto al centro: apre il riquadro «Aggiungi elemento» -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
        <Button x:Name="MapAddBtn" Classes="primary" Content="＋  Aggiungi elemento" IsVisible="False" Padding="16,9" FontSize="13.5" />
        <Button x:Name="ShowGroupsBtn" Classes="mapbtn" IsVisible="False" Padding="14,9" FontSize="13.5" ToolTip.Tip="Mostra o nasconde i bordi colorati dei gruppi">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon x:Name="ShowGroupsIcon" Data="{StaticResource IconEye}" Width="15" Height="15" />
            <TextBlock Text="Gruppi" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="SaveGroupBtn" Classes="accent" IsVisible="False" Padding="16,9" FontSize="13.5">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconFloppy}" Width="14" Height="14" />
            <TextBlock x:Name="SaveGroupText" Text="Salva gruppo" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="NewGroupFromSelBtn" Classes="primary" IsVisible="False" Padding="16,9" FontSize="13.5" Content="＋  Crea gruppo" ToolTip.Tip="Nuovo gruppo con gli elementi scelti" />
        <Button x:Name="AddToGroupBtn" Classes="accent" IsVisible="False" Padding="16,9" FontSize="13.5" ToolTip.ShowOnDisabled="True" ToolTip.Tip="Metti gli elementi scelti in un gruppo esistente">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="Aggiungi a gruppo" VerticalAlignment="Center" />
            <TextBlock Text="▾" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="CreateAreaBtn" Classes="accent" IsVisible="False" ToolTip.ShowOnDisabled="True" Padding="16,9" FontSize="13.5">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource IconPolygon}" Width="14" Height="14" />
            <TextBlock Text="Crea elemento" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <!-- all'avvio, al centro: da dove partire -->
      <Border x:Name="StartCard" Classes="card active" Background="#FF262B33" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="26,22" BoxShadow="0 8 30 0 #40000000">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button x:Name="OpenProjBtn" Classes="wide primary" Content="Apri progetto…" Padding="12,11" FontSize="13.5" />
            <Button x:Name="OpenGpkgBtn" Grid.Column="1" Classes="wide primary" Content="Apri GeoPackage…" Padding="12,11" FontSize="13.5" />
          </Grid>
          <Button x:Name="ClipLinkBtn" Classes="link" HorizontalAlignment="Center">
            <TextBlock TextAlignment="Center" Text="Ritaglia un file grande…" />
          </Button>
          <StackPanel x:Name="RecentPanel" Spacing="4" Margin="0,6,0,0" IsVisible="False">
            <Rectangle Height="1" Fill="{StaticResource CardBorder}" Margin="0,0,0,6" />
            <TextBlock Classes="step" Text="APERTI DI RECENTE" />
            <StackPanel x:Name="RecentList" Spacing="2" />
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- ═══ riquadri di destra: galleggiano sopra la mappa (la mappa resta a tutta larghezza) ═══ -->
      <Border x:Name="RightPanel" Classes="floating" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="360" Margin="0,12,12,64">
        <ScrollViewer Background="{x:Null}" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0" VerticalAlignment="Top">
            <!-- quando non c'è niente da aggiungere o modificare -->
            <Border x:Name="RightHintCard" Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionTitle" Text="Elemento" />
                <TextBlock x:Name="RightHintText" Classes="note" Text="Apri un progetto o un GeoPackage per iniziare." />
              </StackPanel>
            </Border>

            <!-- modifica della linea: punti chiave da spostare, eliminare, aggiungere -->
            <Border x:Name="EditLineCard" Classes="card active" IsVisible="False">
              <StackPanel Spacing="8">
                <TextBlock x:Name="EditLineTitle" Classes="sectionTitle" Text="Modifica linea" />
                <TextBlock x:Name="EditLineInfo" Classes="note" />
                <TextBlock x:Name="EditLineHelp" Classes="note" Text="Trascina un punto per spostarlo · clic su un punto e Canc per toglierlo · doppio clic sulla linea per inserirne uno nuovo. I punti verdi sono agganciati a un altro elemento e lo seguono." />
                <TextBlock x:Name="ExtendLabel" Classes="k" Text="Aggiungi punti" />
                <Grid x:Name="ExtendRow" ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button x:Name="ExtendStartBtn" Classes="wide">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconArrowLeft}" Width="13" Height="13" />
                      <TextBlock Text="Prosegui dall'inizio" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="ExtendEndBtn" Grid.Column="1" Classes="wide">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Prosegui dalla fine" VerticalAlignment="Center" />
                      <PathIcon Data="{StaticResource IconArrowRight}" Width="13" Height="13" />
                    </StackPanel>
                  </Button>
                </Grid>
                <CheckBox x:Name="EditSnapCheck" IsChecked="True" FontSize="12" Content="Aggancia a vertici, muri ed elementi" />
                <CheckBox x:Name="EditFollowCheck" IsChecked="True" FontSize="12">
                  <TextBlock TextWrapping="Wrap" FontSize="12" Text="Segui il contorno tra due punti dello stesso edificio o elemento" />
                </CheckBox>
                <Button x:Name="FinishEditBtn" Classes="wide accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconFloppy}" Width="13" Height="13" />
                    <TextBlock Text="Salva" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <!-- 3. Aggiungi elemento: si sceglie l'elemento e se ne disegna sulla mappa il bordo o l'interasse -->
            <Border x:Name="AddCard" Classes="card" IsVisible="False">
              <StackPanel Spacing="8">
                <DockPanel>
                  <Button x:Name="CloseAddBtn" DockPanel.Dock="Right" Classes="transparent" Content="✕" Padding="8,2" VerticalAlignment="Center" ToolTip.Tip="Chiudi" />
                  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" ItemSpacing="6">
                    <TextBlock x:Name="AddTitle" Classes="sectionTitle" Text="Aggiungi elemento" VerticalAlignment="Center" />
                    <TextBlock x:Name="AddSep0" Classes="sectionTitle" Text="›" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" IsVisible="False" />
                    <Button x:Name="AddCrumbTypeBtn" Classes="link" IsVisible="False" VerticalAlignment="Center" Padding="0" FontSize="13.5" ToolTip.Tip="Torna alla scelta del tipo" />
                    <TextBlock x:Name="AddSep1" Classes="sectionTitle" Text="›" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" IsVisible="False" />
                    <Button x:Name="AddCrumbKindBtn" Classes="link" IsVisible="False" VerticalAlignment="Center" Padding="0" FontSize="13.5" ToolTip.Tip="Torna a Tracciato / Poligono" />
                    <TextBlock x:Name="AddSep2" Classes="sectionTitle" Text="›" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" IsVisible="False" />
                    <Button x:Name="AddCrumbSubBtn" Classes="link" IsVisible="False" VerticalAlignment="Center" Padding="0" FontSize="13.5" ToolTip.Tip="Torna a Bordo / Interasse / Riempimento" />
                  </WrapPanel>
                </DockPanel>
                <StackPanel x:Name="AddBody" Spacing="8">
                  <!-- prima si sceglie solo tracciato o poligono -->
                  <Grid x:Name="KindRow" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <ToggleButton x:Name="KindTrackBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,9" ToolTip.Tip="L'elemento si sviluppa lungo una linea">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconTrack}" Width="15" Height="15" />
                        <TextBlock Text="Tracciato" VerticalAlignment="Center" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="KindPolyBtn" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,9" ToolTip.Tip="Disegni il contorno chiuso dell'elemento">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{StaticResource IconPolygon}" Width="15" Height="15" />
                        <TextBlock Text="Poligono" VerticalAlignment="Center" />
                      </StackPanel>
                    </ToggleButton>
                  </Grid>
                  <!-- tracciato: la sotto-modalità si sceglie con un clic e il disegno parte subito -->
                  <!-- scelta del tipo di elemento, prima di disegnare -->
                  <Grid x:Name="TypeList" ColumnDefinitions="*,*" ColumnSpacing="6" RowSpacing="6" IsVisible="False" />
                  <Grid x:Name="TrackOptions" ColumnDefinitions="*,*,*" ColumnSpacing="6" IsVisible="False">
                    <Button x:Name="SubBorderBtn" Classes="wide accent" HorizontalContentAlignment="Center" Padding="6,9" Content="Bordo" ToolTip.Tip="L'elemento sta da un lato della linea (es. marciapiede lungo i muri)" />
                    <Button x:Name="SubAxisBtn" Grid.Column="1" Classes="wide accent" HorizontalContentAlignment="Center" Padding="6,9" Content="Interasse" ToolTip.Tip="L'elemento sta metà per parte (es. carreggiata, corsia doppia)" />
                    <Button x:Name="SubFillBtn" Grid.Column="2" Classes="wide accent" HorizontalContentAlignment="Center" Padding="6,9" Content="Riempimento" ToolTip.Tip="Occupa lo spazio tra due elementi già disegnati" />
                  </Grid>

                  <StackPanel x:Name="DrawPanel" Spacing="6" IsVisible="False">
                    <TextBlock x:Name="TraceNote" Classes="note" Text="Doppio clic o Invio per finire · Backspace toglie l'ultimo punto · Esc annulla" />
                    <CheckBox x:Name="SnapCheck" IsChecked="True" FontSize="12" Content="Aggancia a vertici, muri ed elementi" />
                    <CheckBox x:Name="FollowCheck" IsChecked="True" FontSize="12">
                      <TextBlock TextWrapping="Wrap" FontSize="12" Text="Segui il contorno tra due punti dello stesso edificio o elemento" />
                    </CheckBox>
                    <Button x:Name="MatchHostBtn" Classes="wide accent" IsVisible="False" />
                    <StackPanel x:Name="TracePanel" Orientation="Horizontal" Spacing="6">
                      <Button x:Name="TraceUndoBtn">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource IconUndo}" Width="13" Height="13" />
                          <TextBlock Text="Elimina ultimo punto" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="TraceFinishBtn" Classes="accent">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource IconFloppy}" Width="13" Height="13" />
                          <TextBlock Text="Salva" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="TraceCancelBtn" Content="✕ Annulla" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel x:Name="RangePanel" Spacing="6" IsVisible="False">
                    <TextBlock x:Name="RangeInfo" Classes="note" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                      <TextBlock Classes="k" Text="Da" VerticalAlignment="Center" />
                      <NumericUpDown x:Name="RangeFrom" Grid.Column="1" Increment="1" FormatString="0.00" Minimum="0" FontSize="12" />
                      <TextBlock Grid.Column="2" Classes="k" Text="A" VerticalAlignment="Center" />
                      <NumericUpDown x:Name="RangeTo" Grid.Column="3" Increment="1" FormatString="0.00" Minimum="0" FontSize="12" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button x:Name="WholeEdgeBtn" Content="Tutto" />
                      <Button x:Name="ConfirmRangeBtn" Content="Conferma tratto" Classes="accent" />
                    </StackPanel>
                  </StackPanel>

                  <!-- il tipo di elemento si sceglie alla fine, prima di «Prosegui» -->
                  <Grid x:Name="TypeRow" ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="False">
                    <TextBlock Classes="k" Text="Tipo" VerticalAlignment="Center" />
                    <ComboBox x:Name="TypeCombo" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="Scegli l'elemento…" />
                  </Grid>

                  <StackPanel x:Name="WidthPanel" Spacing="6" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Classes="k" Text="Larghezza (m)" VerticalAlignment="Center" />
                      <NumericUpDown x:Name="DraftWidthBox" Grid.Column="1" Width="130" Increment="0.1" FormatString="0.00" Minimum="0.05" Maximum="100" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Classes="k" Text="Ignora irregolarità (m)" VerticalAlignment="Center" />
                      <NumericUpDown x:Name="DraftSmoothBox" Grid.Column="1" Width="130" Increment="0.1" FormatString="0.00" Minimum="0" Maximum="10" FontSize="12" />
                    </Grid>
                  </StackPanel>

                  <TextBlock x:Name="OtherInfo" Classes="note" IsVisible="False" />

                  <StackPanel x:Name="CommitPanel" Spacing="8" IsVisible="False">
                    <Grid x:Name="DraftBtnRow" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                      <Button x:Name="FlipDraftBtn" Classes="wide" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource IconSwap}" Width="14" Height="14" />
                          <TextBlock Text="Inverti lato" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="EditDraftLineBtn" Classes="wide" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource IconPencil}" Width="13" Height="13" />
                          <TextBlock Text="Modifica" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="CancelDraftBtn" Classes="wide" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="✕ Annulla" />
                    </Grid>
                    <Button x:Name="CommitBtn" Classes="wide accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconFloppy}" Width="13" Height="13" />
                        <TextBlock Text="Salva" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>


            <Border x:Name="SelPanel" Classes="card" IsVisible="False">
              <StackPanel Spacing="8">
                <TextBlock x:Name="SelTitle" Classes="sectionTitle" Text="Tracciato" />
                <TextBox x:Name="NameBox" FontSize="13" FontWeight="SemiBold" />
                <Grid x:Name="SelTypeRow">
                  <ComboBox x:Name="SelTypeCombo" HorizontalAlignment="Stretch" FontSize="12.5" ToolTip.Tip="Tipo di elemento">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="local:TypeItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Border Classes="tabs">
                  <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="3">
                    <Button x:Name="TabDatiBtn" Classes="tab on" Content="Disegna" />
                    <Button x:Name="TabOptBtn" Grid.Column="1" Classes="tab" Content="Opzioni" />
                    <Button x:Name="TabVarBtn" Grid.Column="2" Classes="tab">
                      <TextBlock x:Name="TabVarText" Text="Variatori (0)" />
                    </Button>
                    <Button x:Name="TabInfoBtn" Grid.Column="3" Classes="tab" Content="Info" />
                  </Grid>
                </Border>

                <!-- Dati -->
                <StackPanel x:Name="TabDati" Spacing="8">
                  <Grid x:Name="SelGroupRow" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Classes="k" Text="Gruppo" VerticalAlignment="Center" />
                    <ComboBox x:Name="SelGroupCombo" Grid.Column="1" HorizontalAlignment="Stretch" FontSize="12.5" />
                  </Grid>
                  <TextBlock x:Name="AttachText" Classes="note" IsVisible="False" />
                  <TextBlock x:Name="SelError" Classes="note" Foreground="{StaticResource ErrorBrush}" IsVisible="False" />

                  <StackPanel x:Name="SelWidthPanel" Spacing="6">
                    <TextBlock Classes="k" Text="Larghezza (m)" />
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="4">
                      <Button x:Name="WMinus50" Content="−0,5" FontSize="11.5" Padding="6,4" />
                      <Button x:Name="WMinus10" Grid.Column="1" Content="−0,1" FontSize="11.5" Padding="6,4" />
                      <NumericUpDown x:Name="SelWidthBox" Grid.Column="2" Increment="0.1" FormatString="0.00" Minimum="0.05" Maximum="100" ShowButtonSpinner="False" FontSize="12" HorizontalContentAlignment="Center" />
                      <Button x:Name="WPlus10" Grid.Column="3" Content="+0,1" FontSize="11.5" Padding="6,4" />
                      <Button x:Name="WPlus50" Grid.Column="4" Content="+0,5" FontSize="11.5" Padding="6,4" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Classes="k" TextWrapping="Wrap" Text="Ignora irregolarità (m)" VerticalAlignment="Center" />
                      <NumericUpDown x:Name="SelSmoothBox" Grid.Column="1" Width="110" Increment="0.1" FormatString="0.00" Minimum="0" Maximum="10" FontSize="12" />
                    </Grid>
                  </StackPanel>

                  <!-- inverti lato e modifica linea sulla stessa riga, a tutta larghezza -->
                  <Grid x:Name="LineBtns" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button x:Name="FlipSelBtn" Classes="wide" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconSwap}" Width="14" Height="14" />
                        <TextBlock Text="Inverti lato" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="EditSelLineBtn" Grid.Column="1" Classes="wide" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconPencil}" Width="13" Height="13" />
                        <TextBlock Text="Modifica la linea" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <TextBlock x:Name="SelRangeLabel" Classes="k" Text="Tratto sulla linea di aggancio (m)" />
                  <Grid x:Name="SelRangeGrid" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                    <TextBlock Classes="k" Text="Da" VerticalAlignment="Center" />
                    <NumericUpDown x:Name="SelFrom" Grid.Column="1" Increment="1" FormatString="0.00" Minimum="0" FontSize="12" />
                    <TextBlock Grid.Column="2" Classes="k" Text="A" VerticalAlignment="Center" />
                    <NumericUpDown x:Name="SelTo" Grid.Column="3" Increment="1" FormatString="0.00" Minimum="0" FontSize="12" />
                  </Grid>


                  <Grid x:Name="AlongPanel" ColumnDefinitions="*,*" ColumnSpacing="6" ToolTip.Tip="Nuovo elemento affiancato, lungo come questo (destra e sinistra guardando la linea dall'inizio verso la fine)">
                    <Button x:Name="AddLeftBtn" Classes="wide" Content="◀ Aggiungi a sinistra" />
                    <Button x:Name="AddRightBtn" Grid.Column="1" Classes="wide" Content="Aggiungi a destra ▶" />
                  </Grid>
                  <!-- converti ed elimina sulla stessa riga, a tutta larghezza -->
                  <Grid x:Name="EndBtns" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button x:Name="ToPolygonBtn" Classes="wide" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Trasforma l'elemento in un poligono con il contorno attuale (non si può tornare indietro)">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconPolygon}" Width="13" Height="13" />
                        <TextBlock Text="Converti in poligono" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="DeleteBtn" Grid.Column="1" Classes="wide" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
                        <TextBlock Text="Elimina elemento" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>

                <!-- Variatori di sezione -->
                <!-- Opzioni: caratteristiche proprie del tipo di elemento -->
                <StackPanel x:Name="TabOpt" Spacing="8" IsVisible="False">
                    <StackPanel x:Name="DividerPanel" Spacing="6">
                      <TextBlock Classes="k" Text="Strisce di mezzeria" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="DivStyleCombo" HorizontalAlignment="Stretch" FontSize="12">
                          <ComboBoxItem>Tratteggiate</ComboBoxItem>
                          <ComboBoxItem>Continue</ComboBoxItem>
                          <ComboBoxItem>Doppie continue</ComboBoxItem>
                        </ComboBox>
                        <NumericUpDown x:Name="DivCountBox" Grid.Column="1" Width="120" Minimum="0" Maximum="8" Increment="1" FormatString="0" FontSize="12" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="DivInfo" Classes="note" VerticalAlignment="Center" />
                        <Button x:Name="DivAutoBtn" Classes="link" Content="Automatico" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="StallPanel" Spacing="6">
                      <CheckBox x:Name="StallCheck" Content="Linee bianche degli stalli di sosta" FontSize="12.5" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBlock Classes="k" Text="Lunghezza degli stalli (m)" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="StallLenBox" Grid.Column="1" Width="120" Minimum="0.5" Maximum="50" Increment="0.5" FormatString="0.00" FontSize="12" />
                      </Grid>
                      <TextBlock x:Name="StallInfo" Classes="note" />
                    </StackPanel>
                    <Grid x:Name="SepPanel" ColumnDefinitions="*,*" ColumnSpacing="6">
                      <ToggleButton x:Name="MixedBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Mista" ToolTip.Tip="Bici e pedoni sullo stesso spazio" />
                      <ToggleButton x:Name="SeparatedBtn" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Separata" ToolTip.Tip="Striscia continua a metà: da una parte le bici, dall'altra i pedoni" />
                    </Grid>
                    <Grid x:Name="HeightPanel" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Classes="k" Text="Altezza (m)" VerticalAlignment="Center" />
                      <NumericUpDown x:Name="HeightBox" Grid.Column="1" Width="120" Minimum="0" Maximum="2" Increment="0.01" FormatString="0.00" FontSize="12" />
                    </Grid>
                    <TextBlock x:Name="OptNone" Classes="note" Text="Nessuna opzione per questo tipo." />
                </StackPanel>

                <StackPanel x:Name="TabVar" Spacing="8" IsVisible="False">
                  <TextBlock x:Name="VarNotAvail" Classes="note" Text="I variatori di sezione si usano sugli elementi tracciati con una larghezza (non sui poligoni né sugli elementi riempiti tra due elementi)." />
                  <!-- variatori di sezione: la larghezza cambia gradualmente tra due punti e resta cambiata dopo -->
                  <StackPanel x:Name="VarPanel" Spacing="6">
                    <TextBlock Classes="note" Text="Tra l'inizio e la fine del variatore la larghezza cambia gradualmente; oltre la fine resta quella nuova. Sulla mappa trascina i pallini per spostare l'inizio (bianco) e la fine (arancione)." />
                    <StackPanel x:Name="VarList" Spacing="4" />
                    <Button x:Name="AddVarBtn" Classes="wide">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconVariator}" Width="14" Height="14" />
                        <TextBlock Text="Aggiungi variatore di sezione" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Border x:Name="VarPickPanel" Classes="inset" IsVisible="False">
                      <StackPanel Spacing="6">
                        <TextBlock x:Name="VarPickText" Classes="note" />
                        <Button x:Name="CancelVarBtn" Content="Annulla" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>

                <!-- Info -->
                <StackPanel x:Name="TabInfo" Spacing="8" IsVisible="False">
                  <Border Classes="inset">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                      <TextBlock x:Name="MLenLabel" Classes="k" Text="Estensione" />
                      <TextBlock x:Name="MLen" Grid.Column="1" Classes="v" />
                      <TextBlock Grid.Row="1" Classes="k" Text="Superficie" />
                      <TextBlock x:Name="MArea" Grid.Row="1" Grid.Column="1" Classes="v" />
                      <TextBlock Grid.Row="2" Classes="k" Text="Larghezza minima" />
                      <TextBlock x:Name="MWMin" Grid.Row="2" Grid.Column="1" Classes="v" />
                      <TextBlock Grid.Row="3" Classes="k" Text="Larghezza massima" />
                      <TextBlock x:Name="MWMax" Grid.Row="3" Grid.Column="1" Classes="v" />
                      <TextBlock Grid.Row="4" Classes="k" Text="Larghezza media" />
                      <TextBlock x:Name="MWMean" Grid.Row="4" Grid.Column="1" Classes="v" />
                    </Grid>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>
      <!-- in basso a destra: penna e testo per disegnare e scrivere note sulla mappa -->
      <StackPanel x:Name="NoteTools" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14" Spacing="6" IsVisible="False">
        <Border x:Name="NoteBar" Background="#FF262B33" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="8,6" IsVisible="False" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel x:Name="NoteColors" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" />
            <Border Width="1" Background="{StaticResource CardBorder}" />
            <StackPanel x:Name="NoteSizes" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
            <Border Width="1" Background="{StaticResource CardBorder}" />
            <ToggleButton x:Name="EraserBtn" Classes="maptool" MinHeight="28" MinWidth="32" Padding="7,5" ToolTip.Tip="Gomma: clic su un disegno o un testo per cancellarlo">
              <PathIcon Data="{StaticResource IconEraser}" Width="15" Height="15" />
            </ToggleButton>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
          <!-- vista: adatta e ruota -->
          <StackPanel x:Name="ViewBtns" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="False">
            <Button x:Name="ZoomBtn" MinHeight="36" VerticalContentAlignment="Center" Content="⤢  Adatta vista" Classes="mapbtn" />
            <Button x:Name="RotPlusBtn" MinHeight="36" VerticalContentAlignment="Center" Content="⟲ +5°" Classes="mapbtn" ToolTip.Tip="Ruota il disegno di 5° in senso antiorario" />
            <Button x:Name="RotMinusBtn" MinHeight="36" VerticalContentAlignment="Center" Content="⟳ −5°" Classes="mapbtn" ToolTip.Tip="Ruota il disegno di 5° in senso orario" />
            <Button x:Name="RotResetBtn" MinHeight="36" VerticalContentAlignment="Center" Classes="mapbtn" IsVisible="False" ToolTip.Tip="Torna con il nord in alto" />
          </StackPanel>
          <Border Width="6" />
          <ToggleButton x:Name="PenBtn" Classes="maptool" Padding="10,7" ToolTip.Tip="Penna: disegna a mano libera sulla mappa">
            <PathIcon Data="{StaticResource IconPencil}" Width="16" Height="16" />
          </ToggleButton>
          <ToggleButton x:Name="TextBtn" Classes="maptool" Padding="10,5" ToolTip.Tip="Testo: clic sulla mappa per scrivere una nota">
            <TextBlock Text="T" FontSize="16" FontWeight="Bold" FontFamily="Georgia, serif" />
          </ToggleButton>
        </StackPanel>
      </StackPanel>

      <!-- sezione aperta: disegno in basso, sopra la mappa -->
      <Border x:Name="SectionPanel" Classes="floating" VerticalAlignment="Bottom" Height="310" Margin="12,0,12,12" IsVisible="False">
        <Border Classes="card" Margin="0" Padding="14,12">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
              <TextBox x:Name="SectionNameBox" Width="190" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock x:Name="SectionInfo" Grid.Column="1" Classes="note" VerticalAlignment="Center" Margin="6,0,0,0" />
              <Button x:Name="SaveSectionPngBtn" Grid.Column="2" ToolTip.Tip="Salva la sezione come immagine PNG (disegno e legenda con le misure)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconFloppy}" Width="13" Height="13" />
                  <TextBlock Text="Salva PNG" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="FlipSectionBtn" Grid.Column="3" ToolTip.Tip="Guarda la sezione dall'altro lato della linea">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="⇄" VerticalAlignment="Center" />
                  <TextBlock Text="Inverti verso" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="DeleteSectionBtn" Grid.Column="4" ToolTip.Tip="Elimina la sezione">
                <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
              </Button>
              <Button x:Name="CloseSectionBtn" Grid.Column="5" Classes="transparent" Content="✕" Padding="8,2" ToolTip.Tip="Chiudi" />
            </Grid>
            <Grid ColumnDefinitions="*,340" ColumnSpacing="14">
              <c:SectionView x:Name="SectionDrawing" />
              <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SectionTable" Spacing="3" />
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </Border>
      </Border>

      <!-- fotoinserimento aperto: occupa esattamente l'area della mappa -->
      <Border x:Name="PhotoHost" IsVisible="False" Background="{StaticResource WindowBackground}" />
    </Panel>
  </DockPanel>
</Window>
