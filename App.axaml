<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CicloDraft.App"
             Name="CicloDraft"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CicloDraft/Themes/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />

    <!-- Stili come SpeedVision: tema scuro, riquadri («card») con cornice verde sul passo da fare -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource WindowBackground}" />
    </Style>

    <!-- ───── Testi ───── -->
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.step">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="17" />
    </Style>
    <Style Selector="TextBlock.k">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.v">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>

    <!-- ───── Contenitori ───── -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- Riquadro della guida: cornice verde di 3 px quando è il prossimo su cui agire -->
    <Style Selector="Border.card.active">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="{StaticResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.toolbar">
      <Setter Property="Background" Value="{StaticResource RailBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="{StaticResource RailBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Rectangle.sep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Fill" Value="{StaticResource CardBorder}" />
      <Setter Property="Margin" Value="6,2" />
    </Style>

    <!-- ───── Pulsanti ───── -->
    <Style Selector="Button">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- primary / accent: l'azione da fare ora, in verde -->
    <Style Selector="Button.primary, Button.accent">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#FF0B0E14" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter, Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#FF0B0E14" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF4DDB8F" />
      <Setter Property="BorderBrush" Value="#FF4DDB8F" />
      <Setter Property="Foreground" Value="#FF0B0E14" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF1FA85F" />
    </Style>
    <Style Selector="Button.transparent">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.transparent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#18FFFFFF" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="Foreground" Value="{StaticResource LineABrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- riquadri che galleggiano sopra la mappa: fondo pieno e ombra -->
    <Style Selector="Border.floating Border.card">
      <Setter Property="Background" Value="#FF262B33" />
      <Setter Property="BoxShadow" Value="0 6 24 0 #50000000" />
    </Style>
    <!-- pulsanti sopra la mappa (chiara): fondo scuro pieno -->
    <Style Selector="Button.mapbtn">
      <Setter Property="Background" Value="#FF262B33" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.mapbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF343A44" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.wide">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.toolbar CheckBox">
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Schede (Dati | Variatori | Info) -->
    <Style Selector="Border.tabs">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.tab.on">
      <Setter Property="Background" Value="#FF3A414C" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF3A414C" />
    </Style>

    <!-- Elenchi nei pannelli -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Application.Styles>
</Application>
